# VibeCraft 多人会合 / TURN 服务器 — 配置模板（committed；真实值放 .secrets/vibecraft-turn.env，勿入 git）
#
# 用法：
#   1. cp deploy/turn/vibecraft-turn.env.example .secrets/vibecraft-turn.env
#   2. 填入真实值（IP / secret / 域名等）
#   3. .secrets/ 已在 .gitignore，真实凭据不会进 git
#
# TURN_STATIC_SECRET 从 VPS 上取：ssh root@<ip> 'cat /etc/vibecraft-turn-secret'

# ── 云实例 ──────────────────────────────────────────────
VPS_PROVIDER="阿里云轻量应用服务器"
VPS_REGION="cn-hongkong (香港)"
VPS_INSTANCE_ID="<实例ID>"
VPS_INSTANCE_NAME="<实例名>"
VPS_OS="Ubuntu 22.04 LTS"
VPS_SPEC="2 vCPU / 2 GiB / 40 GiB / 200 Mbps 不限流量"
VPS_PUBLIC_IP="<公网IP>"
VPS_PRIVATE_IP="<私网IP>"

# ── SSH ─────────────────────────────────────────────────
SSH_USER="root"
SSH_PORT="22"
SSH_KEY=".secrets/<your-key>.pem"
SSH_PASSWORD_FILE=".secrets/<your-password>.txt"

# ── TURN/STUN（coturn）──────────────────────────────────
# 没真实域名就用 <公网IP>.sslip.io（自动解析到该 IP，给 turns:443 的 TLS 证书用）
TURN_DOMAIN="<公网IP>.sslip.io"
TURN_REALM="<公网IP>.sslip.io"
TURN_STATIC_SECRET="<从 VPS /etc/vibecraft-turn-secret 取，勿入 git>"
TURN_PORT="3478"
TURN_TLS_PORT="443"
TURN_RELAY_MIN_PORT="49160"
TURN_RELAY_MAX_PORT="49260"
TURN_CERT="/etc/coturn/certs/fullchain.pem"
TURN_CERT_EXPIRES="<YYYY-MM-DD>"

# ── ICE servers（回填到 vibecraft webrtc.py 的 _ICE_SERVERS）──
STUN_URL="stun:<公网IP>.sslip.io:3478"
TURN_URL="turn:<公网IP>.sslip.io:3478"
TURNS_URL="turns:<公网IP>.sslip.io:443"
